# PaperTrail server configuration template; never place real credentials here.
APP_ENV=development
PAPERTRAIL_DOMAIN=
DATA_STORAGE_PATH=./data/papertrail.sqlite3
# Local PDF parser; MinerU model files are installed separately under MINERU_HOME.
PAPERTRAIL_PDF_PARSER=mineru
PAPERTRAIL_MINERU_TIER=standard
MINERU_HOME=./data/mineru-models
MINERU_MODEL_SOURCE=local
MINERU_TELEMETRY_DISABLED=1
# Optional for small tests; recommended free key increases the daily budget.
OPENALEX_API_KEY=
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8192
LLM_REASONING_EFFORT=
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOTAL_TOKENS=300000
AGENT_DAILY_USER_TOKEN_BUDGET=0
AGENT_MAX_CONTEXT_CHARS=120000
AGENT_DEADLINE_SECONDS=120
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
# Suggested initial OpenAI baseline (only used when provider=openai).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PRICE_PER_MILLION_USD=0.02
LOG_LEVEL=INFO
