# Development template. Generate a local .env with scripts/init_env.py.
APP_ENV=development
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_SIGNING_SECRET=
SESSION_WRITE_LIMIT=60
ADMIN_AUTH_CONFIG=
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_DEADLINE_SECONDS=45
AGENT_ROUTER_MODE=deterministic
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
RETRIEVAL_MODE=bm25
PRICE_MAX_AGE_SECONDS=86400
# Comma-separated IDs from the fixed registry; leave empty to disable all API sources.
AUTHORIZED_PRICE_SOURCES=
# Required only when jd_union is listed above. Keep actual values in .env or a secret manager.
JD_UNION_PERMISSION_REFERENCE=
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
JD_UNION_SITE_ID=
SOURCE_ALLOWLIST=
SOURCE_CREDENTIALS_REFERENCE=
DATA_STORAGE_PATH=./data/storage
LOG_LEVEL=INFO
OTEL_EXPORTER_ENDPOINT=
