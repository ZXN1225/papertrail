# PaperTrail server configuration template; never place real credentials here.
APP_ENV=development
DATA_STORAGE_PATH=./data/papertrail.sqlite3
# Optional for small tests; recommended free key increases the daily budget.
OPENALEX_API_KEY=
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=800
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_DEADLINE_SECONDS=45
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
# Suggested initial OpenAI baseline (only used when provider=openai).
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_PRICE_PER_MILLION_USD=0.13
LOG_LEVEL=INFO
